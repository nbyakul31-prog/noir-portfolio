{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "installCommand": null,
  "framework": null,
  "routes": [
    {
      "src": "/(portfolio_assets/.*|.*\\.(?:png|jpg|jpeg|svg|webp|mp3|ico))",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/$",
      "dest": "/index.html"
    },
    {
      "src": "/index",
      "dest": "/index.html"
    }
  ]
}